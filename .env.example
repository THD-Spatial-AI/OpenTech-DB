# ─────────────────────────────────────────────────────────────────────────────
# opentech-db — Backend environment variables template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED — server will not start without these ───────────────────────────

# Random secret for signing JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Built-in admin account credentials.
# Generate the hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(12)).decode())"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# ── OPTIONAL — ORCID login (researcher authentication) ───────────────────────
# Register a Public API app at: https://orcid.org/developer-tools
# Use "sandbox" for local dev (allows http://localhost), "production" for deployment.
ORCID_ENV=sandbox
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:8000/api/v1/auth/orcid/callback
FRONTEND_URL=http://localhost:5173

# ── OPTIONAL — Supabase (scraper candidates + Supabase auth) ─────────────────
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from: Supabase Dashboard → Settings → API → JWT Secret
# Required for production — without it, Supabase token signatures are not verified.
SUPABASE_JWT_SECRET=

# ── OPTIONAL — GitHub integration (contribution approval → PR) ───────────────
# Personal Access Token with repo scope.
# Required only for the admin approval workflow that opens PRs.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=THD-Spatial-AI/OpenTech-DB

# ── OPTIONAL — LLM extraction (scraper pipeline) ─────────────────────────────
# At least one key enables LLM-assisted parameter extraction from PDFs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── OPTIONAL — Premium academic sources (scraper pipeline) ───────────────────
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=
