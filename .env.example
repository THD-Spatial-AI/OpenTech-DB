# ─────────────────────────────────────────────────────────────────────────────
# OpenTech DB FastAPI environment
# Copy to .env. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Standalone Go authentication service. For production, prefer a private
# network address; the browser uses the same-origin /auth-api reverse proxy.
AUTH_SERVICE_URL=http://localhost:8001
AUTH_REALM=opentechdb

# Must exactly match AUTH_INTERNAL_SECRET on the Go auth service.
# Generate independently: openssl rand -base64 48
AUTH_INTERNAL_SECRET=

FRONTEND_URL=http://localhost:5173
# Optional comma-separated override. Exact origins only; no wildcard with cookies.
CORS_ORIGINS=http://localhost:5173

# Server-side data storage. It is required for personal API tokens and durable
# workflow/catalogue storage. Supabase is not an identity provider and no key is
# sent to the React application.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional contribution approval integration.
GITHUB_TOKEN=
GITHUB_REPO=THD-Spatial-AI/OpenTech-DB

# Optional best-effort submission status email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional LLM-assisted scraper extraction.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional premium academic sources.
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=
