# ──────────────────────────────────────────────────────────────────
# Timeseries data files
# Profile data and pending submissions are stored in Supabase
# (migration 010).  timeseries_catalogue.json is kept only as a
# local-dev fallback — the per-profile and pending JSON blobs are
# ignored to keep the repo lean.
# ──────────────────────────────────────────────────────────────────
data/timeseries/pending/
data/timeseries/*.json
!data/timeseries/timeseries_catalogue.json
!data/timeseries/ci_test_fixture.json

# Node / frontend (already covered by frontend/.gitignore too)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Pending submissions uploaded by contributors
data/pending_submissions/*.json

# Backup files created during data editing
data/**/*.bak

# Local utility scripts — not part of the project
scripts/

# Local data files not part of the catalogue
data/wind_turbine_library.csv

# ──────────────────────────────────────────────────────────────────
# Scraper runtime data — candidates, raw API dumps, scheduler state.
# This is stored in Supabase (production) or a Docker volume.
# It must NOT be committed to the repo.
# ──────────────────────────────────────────────────────────────────
data/scraped/

.github/agents/
github/
__pycache__/
docker-compose.yml
/.agents
CLAUDE.md
/.claude

node_modules

# ── Supabase CLI runtime (never commit) ──────────────────────────────────────
supabase/.branches/
supabase/.temp/
supabase/.git/