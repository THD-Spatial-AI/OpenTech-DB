# ── FastAPI backend ───────────────────────────────────────────────────────────
# Defaults to http://localhost:8000/api/v1 when unset.
# Override with a tunnel URL (e.g. ngrok) during remote development.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AUTH_API_BASE_URL=/auth-api

# ── Tech Simulator ────────────────────────────────────────────────────────────
# Catalogue source for the simulator's component pickers. Points at this repo's
# own backend host (paths append /api/v1). Falls back to https://otdb.th-deg.de
# when unset.
VITE_TECH_API_URL=http://localhost:8000
# Physics simulation services (docker compose: ccssim / hydrogensim). The dev
# server proxies /h2-proxy and /ccs-proxy to these targets.
VITE_H2_SERVICE_URL=http://localhost:8765
VITE_CCS_SERVICE_URL=http://localhost:8766
# Process simulation service (steady-state flowsheet engine). Dev proxies /process-proxy.
VITE_PROCESS_SERVICE_URL=http://localhost:8770
