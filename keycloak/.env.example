# Copy to .env for a remote deployment, or .env.local for localhost.
# Generate each secret independently, for example: openssl rand -base64 48
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
OPENTECHDB_CLIENT_SECRET=replace-with-a-long-random-password
AUTH_INTERNAL_SECRET=replace-with-at-least-32-random-characters

# Remote deployment only. Use the DNS name that points to the Keycloak server.
KEYCLOAK_DOMAIN=auth.example.org

# Browser callbacks must go through the OpenTech DB app's same-origin
# /auth-api reverse proxy so its opaque cookies belong to the app host.
OPENTECHDB_FRONTEND_URL=https://opentechdb.example.org
OPENTECHDB_AUTH_PUBLIC_URL=https://opentechdb.example.org/auth-api
OPENTECHDB_AUTH_CALLBACK_URL=https://opentechdb.example.org/auth-api/auth/callback
