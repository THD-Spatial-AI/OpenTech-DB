# hydrogen-plant-sim environment variables (OpenModelica Edition)
# Copy this file to .env and customize as needed.
#
#   cp .env.example .env

# ── Service binding ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8765

# ── Engine startup ────────────────────────────────────────────────────────────
# AUTO_START_ENGINE: Set to "1" to start OpenModelica engine on container startup
# Set to "0" if you want to manually trigger via /api/restart-engine
AUTO_START_ENGINE=1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use * to allow all (default — convenient for development).
# Restrict to specific origins in production, e.g.:
#   CORS_ORIGINS=http://localhost:5173,http://localhost:4173,app://.
CORS_ORIGINS=*

# ── OpenModelica Configuration ────────────────────────────────────────────────
# No additional configuration needed! OpenModelica is open-source.
# The OMPython package auto-discovers the OpenModelica installation.
#
# Optional: Override OMC executable path (usually auto-detected)
# OMC_PATH=/usr/bin/omc

