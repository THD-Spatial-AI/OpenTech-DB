within ;
package H2PowerPlant "Hydrogen Power Plant Digital Twin - Component Library"
  annotation (
    version="2.0.0",
    uses(Modelica(version="4.0.0")),
    Documentation(info="<html>
<h1>H2PowerPlant Library</h1>
<p>Component-based modeling library for hydrogen production and power generation systems.</p>
<p>Integrated with TEMPO Calliope Edition Tool via FastAPI bridge.</p>
<p>Schema version: 2.0 (all units explicit)</p>
</html>"));
end H2PowerPlant;
