# Process Simulation Service (ADR-0004 / ADR-0005)

HOST=0.0.0.0
PORT=8770

# Engine: steady_state (default, pure Python) | openmodelica (needs omc + toolchain)
PROCESS_ENGINE=steady_state

# Internal trust: the sim service only accepts jobs carrying this shared secret,
# which the opentech-db backend sends. MUST match the backend's PROCESS_SIM_SECRET.
# Leave empty ONLY for local development (then the service is unauthenticated).
PROCESS_SIM_SECRET=

# Catalogue API used to resolve a Unit's technology_ref → parameters.
CATALOGUE_API_URL=http://localhost:8000/api/v1

# Job queue policy
PROCESS_JOB_TIMEOUT_S=180     # per-job wall-clock budget
PROCESS_MIN_FREE_MB=1000      # hold dispatch below this free-memory floor
# PROCESS_WORKERS=1           # (reserved) concurrent workers

# OpenModelica home (only needed off-PATH, e.g. a Windows dev box)
# OPENMODELICAHOME=C:\Program Files\OpenModelica1.26.3-64bit
